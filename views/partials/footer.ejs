<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-col">
      <div class="logo">
        <img src="/img/logo-hidromarket25-v3b.svg" alt="<%= site.companyName %>" class="site-logo-img">
      </div>
      <p class="footer-partner"><%- t('footer.partnerText', { partner: '<strong>' + site.partner + '</strong>' }) %></p>
      <div class="partner-badge">
        <img src="/img/partners/hipomak-logo.png" alt="Hipomak Hydraulic — официальный логотип">
      </div>
      <div class="partner-badge partner-badge-sel">
        <img src="/img/partners/sel-hortumlari-logo.png" alt="SEL Hortumları by Danfoss">
        <span><%= t('partner.badgeSel') %></span>
      </div>
    </div>

    <div class="footer-col">
      <h4><%= t('footer.sections') %></h4>
      <a href="/uslugi"><%= t('nav.services') %></a>
      <a href="/katalog"><%= t('nav.catalog') %></a>
      <a href="/o-nas"><%= t('nav.about') %></a>
      <a href="/kontakty"><%= t('nav.contacts') %></a>
    </div>

    <% const footerPhoneDigits = site.phone.replace(/\D/g, ''); %>
    <div class="footer-col">
      <h4><%= t('footer.contacts') %></h4>
      <p><%= t('contacts.phone') %>: <a href="tel:<%= site.phone.replace(/\s/g, '') %>"><%= site.phone %></a></p>
      <p><%= t('contacts.servicePhone') %>: <a href="tel:<%= site.servicePhone.replace(/\s/g, '') %>"><%= site.servicePhone %></a></p>
      <p>Email: <a href="mailto:<%= site.email %>"><%= site.email %></a></p>
      <p><%= t('contacts.address') %>: <%= t('site.address') %></p>
      <div class="footer-social">
        <span><%= t('footer.social') %>:</span>
        <a href="https://wa.me/<%= footerPhoneDigits %>" target="_blank" rel="noopener"><%= t('contacts.whatsapp') %></a>
        <a href="viber://chat?number=%2B<%= footerPhoneDigits %>"><%= t('contacts.viber') %></a>
        <a href="<%= site.instagram %>" target="_blank" rel="noopener">Instagram</a>
        <a href="<%= site.tiktok %>" target="_blank" rel="noopener">TikTok</a>
      </div>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container">© <%= new Date().getFullYear() %> <%= site.companyName %>. <%= t('footer.rights') %></div>
  </div>
</footer>

<a href="https://wa.me/<%= site.phone.replace(/\D/g, '') %>" target="_blank" rel="noopener" class="whatsapp-float" aria-label="WhatsApp">
  <svg viewBox="0 0 32 32" width="30" height="30" fill="#fff" aria-hidden="true">
