<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="logo logo-chip">
      <img src="/img/logo-hidromarket25-v3b.svg" alt="<%= site.companyName %>" class="site-logo-img">
    </a>

    <div class="partner-badge partner-badge-header">
      <img src="/img/partners/hipomak-logo.png" alt="Hipomak Hydraulic — официальный партнёр">
      <span><%= t('partner.badge', { year: 1988 }) %></span>
    </div>

    <div class="partner-badge partner-badge-header partner-badge-sel">
      <img src="/img/partners/sel-hortumlari-logo.png" alt="SEL Hortumları by Danfoss">
      <span><%= t('partner.badgeSel') %></span>
    </div>

    <nav class="main-nav">
      <a href="/" class="<%= page === 'home' ? 'active' : '' %>"><%= t('nav.home') %></a>
      <a href="/uslugi" class="<%= page === 'services' ? 'active' : '' %>"><%= t('nav.services') %></a>
      <a href="/katalog" class="<%= page === 'catalog' ? 'active' : '' %>"><%= t('nav.catalog') %></a>
      <a href="/o-nas" class="<%= page === 'about' ? 'active' : '' %>"><%= t('nav.about') %></a>
      <a href="/kontakty" class="<%= page === 'contacts' ? 'active' : '' %>"><%= t('nav.contacts') %></a>
    </nav>

    <div class="header-search">
      <div class="search-box" id="site-search">
        <svg class="search-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
          <path fill="currentColor" d="M21 20.3 15.6 15a8 8 0 1 0-1.4 1.4l5.3 5.4ZM4.5 10.5a6 6 0 1 1 12 0 6 6 0 0 1-12 0Z"/>
        </svg>
        <input
          type="text"
          id="site-search-input"
          class="search-input"
          placeholder="<%= t('search.placeholder') %>"
          autocomplete="off"
          role="combobox"
          aria-expanded="false"
          aria-controls="site-search-results"
        />
        <div id="site-search-results" class="search-results" role="listbox" hidden></div>
      </div>
    </div>

    <div class="lang-switcher">
      <% langs.forEach(function(l) { %>
        <a href="?lang=<%= l %>" class="<%= l === lang ? 'active' : '' %>"><%= l.toUpperCase() %></a>
      <% }); %>
    </div>

    <button class="nav-toggle" id="nav-toggle" aria-label="Меню" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
