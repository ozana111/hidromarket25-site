<!DOCTYPE html>
<html lang="<%= lang %>">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <% const title = `${product.name} — ${site.companyName}`; %>
  <% const description = product.description; %>
  <title><%= title %></title>
  <meta name="description" content="<%= description %>">
  <%- include('partials/seo', { title, description }) %>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="container product-detail">
      <div class="product-detail-image">
        <img src="<%= product.image %>" alt="<%= product.name %>">
      </div>
      <div class="product-detail-body">
        <span class="product-category"><%= t('catalogCategories.' + product.category) %></span>
        <h1><%= product.name %></h1>
        <p class="product-brand-line"><%= product.brand %> · <%= t('product.modelLabel') %> <%= product.model %></p>
        <p class="product-description"><%= product.description %></p>
        <p class="product-price"><%= t('product.priceLabel') %>: <%= product.price === 'по запросу' ? t('product.onRequest') : product.price %></p>
        <a href="/kontakty" class="btn btn-primary"><%= t('product.cta') %></a>
      </div>
    </div>

    <% if (related.length) { %>
    <div class="container">
      <h2 class="section-title"><%= t('product.relatedTitle') %></h2>
      <div class="card-grid">
        <% related.forEach(function(p) { %>
          <a href="/katalog/<%= p.slug %>" class="product-card">
            <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy">
            <div class="product-card-body">
              <span class="product-category"><%= t('catalogCategories.' + p.category) %></span>
              <h3><%= p.name %></h3>
              <span class="product-brand"><%= p.brand %> · <%= p.model %></span>
            </div>
          </a>
        <% }); %>
      </div>
    </div>
    <% } %>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
