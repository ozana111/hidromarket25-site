<link rel="canonical" href="<%= site.baseUrl %><%= canonicalPath %>">
<link rel="icon" type="image/svg+xml" href="/img/logo-hidromarket25-v3b.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<meta name="robots" content="<%= typeof robots !== 'undefined' ? robots : 'index, follow' %>">
<meta property="og:type" content="website">
<meta property="og:site_name" content="<%= site.companyName %>">
<meta property="og:locale" content="<%= lang %>">
<meta property="og:url" content="<%= site.baseUrl %><%= canonicalPath %>">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="<%= title %>">
<meta name="twitter:description" content="<%= description %>">
